export interface IWebSocketClient {
    postMessage: (payload: string) => void;
    onMessage: (cb: (message: string) => void) => void;
    onOpen: (cb: () => void) => void;
    onClose: (cb: () => void) => void;
    close?: (...args: any[]) => any;
}
export type Klass4WebsocketClient = new (url: string) => IWebSocketClient;
